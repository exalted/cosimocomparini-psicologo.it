#!/usr/bin/env bash

set -euo pipefail
trap "echo 'error: Script failed: see failed command above'" ERR

cd "$(dirname "$0")/.."

if [ -s "${NVM_DIR:-$HOME/.nvm}/nvm.sh" ]; then
  # shellcheck disable=SC1091
  . "${NVM_DIR:-$HOME/.nvm}/nvm.sh"
  nvm use >/dev/null 2>&1 || nvm install
else
  echo "error: nvm not found. Install from https://github.com/nvm-sh/nvm" >&2
  exit 1
fi

if command -v rbenv >/dev/null 2>&1; then
  eval "$(rbenv init - bash)"
  rbenv version >/dev/null  # fails loudly if .ruby-version isn't installed
else
  echo "error: rbenv not found. Install with: brew install rbenv" >&2
  exit 1
fi

# Sync the upstream Psicologi-Italia widget for reference and regenerate the
# served patched copy (psi-widget-modified.js):
#  - Upstream is an IIFE renderable to a single hardcoded container ID. Our
#    pages need two instances (desktop + mobile layouts), so we rewrite it
#    into a `createWidget(id)` function.
#  - Upstream sometimes ships the doctor's profile_image src as a relative
#    path or under the broken `cdn.` host; force it to absolute `www.`.
#  - Upstream re-stamps the CSS cache-buster with a fresh unix timestamp on
#    every request, so we normalize it to keep the synced file stable.
widget_dir="assets/vendor/psicologi-italia.it"
widget_upstream="$widget_dir/psi-widget.js"
widget_served="$widget_dir/psi-widget-modified.js"
widget_tmp="$(mktemp)"
widget_patched_tmp="$(mktemp)"
trap 'rm -f "$widget_tmp" "$widget_patched_tmp"' EXIT
if curl -sfS --max-time 5 -o "$widget_tmp" https://www.psicologi-italia.it/api/psicologo/cosimo-giuseppe-comparini/psi-widget.js; then
  sed -i.bak 's/legacy_widget_style\.css?v=[0-9]*/legacy_widget_style.css?v=upstream/g' "$widget_tmp" && rm -f "$widget_tmp.bak"
  if ! cmp -s "$widget_tmp" "$widget_upstream"; then
    cp "$widget_tmp" "$widget_upstream"
  fi
  sed -E \
    -e 's/^\(function \(\) \{$/function createWidget(id) {/' \
    -e '/^    var id = "[a-f0-9]{40}",$/d' \
    -e 's/getElementById\("iw_widget_[a-f0-9]{40}"\)/getElementById("iw_widget_"+id)/' \
    -e 's/^\}\)\(\);$/}/' \
    -e 's#"src":"https?:\\/\\/(www|cdn)\.psicologi-italia\.it\\/uploads#"src":"https:\\/\\/www.psicologi-italia.it\\/uploads#g' \
    -e 's#"src":"\\/uploads#"src":"https:\\/\\/www.psicologi-italia.it\\/uploads#g' \
    "$widget_upstream" > "$widget_patched_tmp"
  if ! cmp -s "$widget_patched_tmp" "$widget_served"; then
    cp "$widget_patched_tmp" "$widget_served"
  fi
fi

npx concurrently --names "jekyll,postcss,prettier" --kill-others \
  'bundle exec jekyll serve --open-url --livereload' \
  'npx postcss styles.css --output docs/styles.css --watch' \
  'npx onchange "**/*.html" "**/*.md" --exclude-path .gitignore -- npx prettier --write {{changed}}' \
|| true
